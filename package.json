{
  "name": "ecommerce-bio-quinoa",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=@raiz/web",
    "dev:api": "npm run start:dev --workspace=@raiz/api",
